# Copy to backend/.env and fill in real values.
# Do NOT commit the real .env (it is gitignored).

# Replicate API token (https://replicate.com/account/api-tokens)
# Used for Stable Diffusion inpainting.
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# HuggingFace API token (https://huggingface.co/settings/tokens)
# Used for clothing segmentation (segformer_b2_clothes)
# and person detection (facebook/detr-resnet-50).
HF_API_TOKEN=hf_your_huggingface_token_here

# Absolute path to the directory where per-session data is stored
# (videos, frames, masks, products, processed outputs, exports).
# Use forward slashes even on Windows.
SD_STORAGE=D:/projects for fun/stable-diffusion/sd-overlay
